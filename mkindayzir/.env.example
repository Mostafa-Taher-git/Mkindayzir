# ─── Core ───────────────────────────────────────
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000
MKINDAYZIR_MODE=personal           # personal | team | enterprise
AUTO_LOGIN=false                   # Auto-login for Personal Mode (single user)

# ─── Database ───────────────────────────────────
DATABASE_PROVIDER=sqlite           # sqlite | postgresql
DATABASE_URL=file:./data/mkindayzir.db
# For PostgreSQL: DATABASE_URL=postgresql://mkindayzir:password@localhost:5432/mkindayzir
DATA_DIR=./data

# ─── Security ──────────────────────────────────
SESSION_SECRET=<64-char-random-string>
ENCRYPTION_KEY=<32-byte-hex-string>
SESSION_MAX_AGE=86400
BCRYPT_ROUNDS=12

# ─── File Storage ──────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE=26214400
BACKUP_DIR=/app/data/backups

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=20
RATE_LIMIT_AUTH=5

# ─── AI (Optional) ─────────────────────────────
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_AI_MODEL=anthropic/claude-sonnet-4-20250514
PYTHON_AI_URL=http://localhost:8000   # Python AI service URL

# ─── Email (Optional) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mkindayzir.local

# ─── Logging ───────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Features ──────────────────────────────────
REGISTRATION_ENABLED=false
GUIDE_CENTER_ENABLED=true
MAX_PROJECTS=0
MAX_USERS=0
