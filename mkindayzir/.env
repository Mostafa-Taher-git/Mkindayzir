NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://mkindayzir:password@localhost:5432/mkindayzir

SESSION_SECRET=dev-session-secret-change-in-production-64-chars-minimum!!
ENCRYPTION_KEY=dev-encryption-key-change-in-production-32-bytes-hex!!
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production
SESSION_MAX_AGE=3600
BCRYPT_ROUNDS=12

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE=52428800
BACKUP_DIR=/app/data/backups

RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=20
RATE_LIMIT_AUTH=5

DEFAULT_AI_PROVIDER=openrouter
DEFAULT_AI_MODEL=anthropic/claude-3.5-sonnet

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mkindayzir.local

LOG_LEVEL=info
LOG_FORMAT=json

REGISTRATION_ENABLED=false
GUIDE_CENTER_ENABLED=true
MAX_PROJECTS=0
MAX_USERS=0
