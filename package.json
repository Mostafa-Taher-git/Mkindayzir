{
  "name": "mkindayzir",
  "version": "1.0.0",
  "description": "Mkindayzir - Your Operations, Your Server, Your Control.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "prisma:generate": "node prisma/generate.mjs",
    "prisma:migrate": "DATABASE_PROVIDER=postgresql prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:push": "node prisma/generate.mjs && DATABASE_PROVIDER=sqlite prisma db push",
    "db:setup": "node prisma/generate.mjs && DATABASE_PROVIDER=sqlite prisma db push && tsx prisma/seed.ts",
    "dev:server": "tsx src/server.ts",
    "start:server": "NODE_ENV=production tsx src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
