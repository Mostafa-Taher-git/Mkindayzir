# OpsDesk environment configuration (COPY to .env and fill in real values).
# NEVER commit the real .env — it holds secrets. .env is git-ignored.

# Secret used to sign session cookies AND mint CSRF tokens.
# Generate a strong one:  python -c "import secrets;print(secrets.token_hex(32))"
OPERADESK_SECRET=change-me-to-a-long-random-string

# Optional: separate secret for CSRF tokens (defaults to OPERADESK_SECRET).
# OPERADESK_CSRF_SECRET=change-me-too

# Set to 1 in production so the session cookie is only sent over HTTPS.
OPERADESK_COOKIE_SECURE=0

# Set to 1 only for local development auto-reload.
OPSDESK_DEBUG=0

# OpenRouter provider key for AI assist.
# OPERADESK_OPENROUTER_KEY=

# AI flag. Leave empty to auto-detect from key presence, or set 0/1 explicitly.
# OPERADESK_AI_ENABLED=

# Default free model offered in Settings.
# OPERADESK_AI_MODEL=deepseek/deepseek-chat:free

# Outbound email (optional). When unset, notifications use in-app only.
# OPERADESK_SMTP_HOST=
# OPERADESK_SMTP_PORT=587
# OPERADESK_SMTP_USER=
# OPERADESK_SMTP_PASS=
# OPERADESK_SMTP_FROM=noreply@opsdesk.local
# OPERADESK_APP_URL=http://localhost:5000

# Password reset token lifetime.
# OPERADESK_RESET_TOKEN_MINUTES=30

# KB article caps.
# OPERADESK_MAX_KB_BODY=20000
# OPERADESK_MAX_KB_TITLE=200
