# ─── Core ───────────────────────────────────────
NODE_ENV=production
PORT=8000
BASE_URL=http://localhost:8000
AUTO_LOGIN=false                   # Auto-login for Personal Mode (single user)

# ─── Database ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mkindayzir:YOUR_PASSWORD@127.0.0.1:5432/mkindayzir
DB_PASSWORD=change-me-in-production
# For PostgreSQL: DATABASE_URL=postgresql://mkindayzir:password@localhost:5432/mkindayzir
DATA_DIR=./data

# ─── Security ──────────────────────────────────
SESSION_SECRET=<64-char-random-string>
ENCRYPTION_KEY=<32-byte-hex-string>
SESSION_MAX_AGE=86400
BCRYPT_ROUNDS=12

# ─── File Storage ──────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=26214400
BACKUP_DIR=./data/backups

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=20
RATE_LIMIT_AUTH=5

# ─── AI (Optional) ─────────────────────────────
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_AI_MODEL=anthropic/claude-sonnet-4-20250514
PYTHON_AI_URL=http://localhost:8000   # Python AI service URL

# ─── Email (Optional) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mkindayzir.local

# ─── Logging ───────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Features ──────────────────────────────────
REGISTRATION_ENABLED=false
GUIDE_CENTER_ENABLED=true
MAX_PROJECTS=0
MAX_USERS=0
# ─── CORS ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
